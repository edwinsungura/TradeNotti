# Database
DATABASE_URL="postgresql://tradenotti:tradenotti@localhost:5432/tradenotti?schema=public"

# Auth.js (NextAuth v5)
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional in dev)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OpenAI — daily insights
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Cron protection for /api/cron/daily-insight
CRON_SECRET="change-me"

# ---- Pre-launch waitlist ----
# Seal the app + auth behind the waitlist landing. "1" / "true" / "on" to enable.
WAITLIST_MODE="true"
# When the next cohort opens (ISO 8601, UTC). Drives the countdown + copy.
NEXT_PUBLIC_LAUNCH_DATE="2026-08-04T13:00:00Z"
# Visible head-start so the line never reads "1 in line". Real signups add on top.
NEXT_PUBLIC_WAITLIST_BASE_COUNT="4479"
