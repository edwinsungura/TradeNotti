# Database
DATABASE_URL="postgresql://tradenotti:tradenotti@localhost:5432/tradenotti?schema=public"

# Auth.js (NextAuth v5)
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional in dev)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OpenAI — daily insights
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Cron protection for /api/cron/daily-insight
CRON_SECRET="change-me"

# ---- Pre-launch waitlist ----
# Seal the app + auth behind the waitlist landing. "1" / "true" / "on" to enable.
WAITLIST_MODE="true"
# When the next cohort opens (ISO 8601, UTC). Drives the countdown + copy.
NEXT_PUBLIC_LAUNCH_DATE="2026-08-01T13:00:00Z"
# Real-by-default: the public count is the actual number of signups. Set a
# number here only if you ever want a visible head-start added on top.
NEXT_PUBLIC_WAITLIST_BASE_COUNT="0"

# ---- Waitlist email sync (optional — leave EMAIL_PROVIDER blank to skip) ----
# One of: mailchimp | convertkit | webhook
EMAIL_PROVIDER=""
# Mailchimp
MAILCHIMP_API_KEY=""        # e.g. "xxxxxxxx-us21" (datacenter is the suffix)
MAILCHIMP_AUDIENCE_ID=""    # Audience → Settings → Audience ID
# ConvertKit
CONVERTKIT_API_KEY=""
CONVERTKIT_FORM_ID=""
# Generic webhook (receives a JSON POST per signup)
EMAIL_WEBHOOK_URL=""
EMAIL_WEBHOOK_SECRET=""     # optional; sent as "Authorization: Bearer <secret>"
